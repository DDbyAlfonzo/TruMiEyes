{
  "name": "trumieyes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "verify:ci": "npm test && NEXT_DIST_DIR=.next.ci npm run build",
    "smoke": "node --import tsx scripts/smoke.ts",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "start": "next start",
    "export": "next export",
    "functions:serve": "npm --prefix functions run serve",
    "functions:deploy": "npm --prefix functions run deploy",
    "prisma": "prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@studio-freight/lenis": "^1.0.42",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "formidable": "^3.5.1",
    "gsap": "^3.14.2",
    "lucide-react": "^1.21.0",
    "next": "^15.4.1",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
